{
  "name": "ie-page-transitions",
  "version": "0.0.3",
  "description": "Bringing back Internet Explorer’s Page Transitions thanks to the View Transition API",
  "type": "module",
  "main": "./src/ie-page-transitions.spa.js",
  "module": "./src/ie-page-transitions.spa.js",
  "style": "./src/ie-page-transitions.css",
  "exports": {
    ".": "./src/ie-page-transitions.spa.js",
    "./spa": "./src/ie-page-transitions.spa.js",
    "./mpa": "./src/ie-page-transitions.mpa.js",
    "./shared": "./src/ie-page-transitions.shared.js",
    "./css": "./src/ie-page-transitions.css",
    "./*": "./src/*"
  },
  "scripts": {
    "deploy": "netlify deploy --prod",
    "build": "node scripts/build.js",
    "prepublishOnly": "if [ -z $PUBLISH ]; then echo '\\n🛑 ERROR: This package must be published using `npm run pub`\\n' && exit 1; fi",
    "pub": "PUBLISH=true npm run build && npm publish ./dist",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "serve demo",
    "prestart": "npm run copy-demo-assets",
    "copy-demo-assets": "rm -rf demo/dist && mkdir demo/dist && cp -R -L src/* demo/dist",
    "capture-video": "node scripts/capture-video.mjs",
    "prevent-dirty-tree": "exit $(git status --porcelain | wc -l)",
    "preversion": "npm run prevent-dirty-tree"
  },
  "author": {
    "name": "Bramus Van Damme",
    "email": "bramus@bram.us",
    "url": "https://www.bram.us/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bramus/ie-page-transitions.git"
  },
  "bugs": {
    "url": "https://github.com/bramus/ie-page-transitions/issues"
  },
  "homepage": "https://page-transitions.style",
  "keywords": [
    "animation",
    "css",
    "page-transition",
    "page-transitions",
    "view-transition-api",
    "view-transitions"
  ],
  "devDependencies": {
    "serve": "^14.2.1"
  }
}
